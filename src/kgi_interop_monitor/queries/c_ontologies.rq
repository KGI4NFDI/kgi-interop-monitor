# c_ontologies: which ontologies, in which versions, the endpoint serves (C4).
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT ?ontology ?versionIRI ?versionInfo WHERE {
  ?ontology a owl:Ontology .
  OPTIONAL { ?ontology owl:versionIRI ?versionIRI }
  OPTIONAL { ?ontology owl:versionInfo ?versionInfo }
} LIMIT 200
